# Exemple uniquement. Aucun secret réel dans Git.
NODE_ENV=production
PORT=3000
# Origine HTTPS définitive exacte, sans / final. Ne pas changer après création des passkeys.
SHIMIX_ORIGIN=
# Générer un secret aléatoire d'au moins 32 octets, le saisir dans les secrets du service.
SHIMIX_BOOTSTRAP_TOKEN=
# URL privée PostgreSQL avec sslmode=verify-full et CA de confiance.
DATABASE_URL=
# Pour les essais locaux uniquement, sans DATABASE_URL :
# NODE_ENV=development
# SHIMIX_ORIGIN=http://localhost:3000
# SHIMIX_SQLITE_FILE=/chemin/prive/shimix.sqlite
